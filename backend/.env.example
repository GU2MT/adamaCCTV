# Database connection string (Postgres with PostGIS)
# Example: postgresql://postgres:postgres@localhost:5433/adama_cctv
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/adama_cctv

# Port for Express server
PORT=5000

# For JWT and other secrets (if used later)
JWT_SECRET=replace_this_with_a_strong_secret
